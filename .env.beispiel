# Vorlage fuer die .env — KEINE echten Werte hier eintragen!
# Diese Datei ist im Repo und dient nur als Checkliste, welche Zugaenge es gibt.
# Die echten Werte bekommst du (Jannik) separat von Lukas — nie ueber GitHub/WhatsApp.
#
# Vorgehen: diese Datei nach ".env" kopieren und die Werte einsetzen.
#   Windows:  copy .env.beispiel .env
#
# Fuer die CRM-Entwicklung brauchst du eigentlich nur die mit [CRM] markierten.
# Der Rest ist fuers Operating System (Alexandra, Sprache, WhatsApp) — kann leer bleiben,
# dann sind diese Bereiche lokal einfach inaktiv. Der Server startet trotzdem.

# --- Grundlage -------------------------------------------------------------
PORT=3000
DASHBOARD_PASSWORD=            # gemeinsames Passwort (Rueckfallebene, ohne CRM)
SESSION_SECRET=               # beliebige lange Zeichenkette
VAULT_PATH=C:/dev/flowstate-vault   # Pfad zu deinem geklonten Vault-Ordner
DATA_PATH=./data

# --- CRM [CRM] -------------------------------------------------------------
# Die Supabase-Datenbank. OHNE diese laeuft das CRM nicht.
DATABASE_URL=

# --- Alexandra / Hermes (Operating System) ---------------------------------
HERMES_CHAT_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# --- WhatsApp (optional) ---------------------------------------------------
# In welche Gruppen Alexandra schreiben darf — Namen exakt wie in WhatsApp,
# mit Komma getrennt. Was hier nicht steht, ist gesperrt (private Gruppen also
# automatisch). Leer = gar keine Gruppen.
WA_GRUPPEN=

# --- Sprachbereich (optional) ----------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SCHNELL_CHAT_URL=
SCHNELL_API_KEY=
WAKE_WORD=
# Modell fuers VERSTEHEN der Sprachbefehle (Standard: claude-sonnet-5).
# Auf claude-haiku-4-5 stellen, wenn es guenstiger sein soll (versteht schlechter).
SPRACHE_VERSTEHEN_MODEL=
# Sprachprotokoll: Tagesdateien unter data/sprachlog/, Aufbewahrung in Tagen (Standard 30).
SPRACHLOG_TAGE=
