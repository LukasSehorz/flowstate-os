# Vorlage fuer die .env — KEINE echten Werte hier eintragen!
# Diese Datei ist im Repo und dient nur als Checkliste, welche Zugaenge es gibt.
# Die echten Werte bekommst du (Jannik) separat von Lukas — nie ueber GitHub/WhatsApp.
#
# Vorgehen: diese Datei nach ".env" kopieren und die Werte einsetzen.
#   Windows:  copy .env.beispiel .env
#
# Fuer die CRM-Entwicklung brauchst du eigentlich nur die mit [CRM] markierten.
# Der Rest ist fuers Operating System (Alexandra, Sprache, WhatsApp) — kann leer bleiben,
# dann sind diese Bereiche lokal einfach inaktiv. Der Server startet trotzdem.

# --- Grundlage -------------------------------------------------------------
PORT=3000
DASHBOARD_PASSWORD=            # gemeinsames Passwort (Rueckfallebene, ohne CRM)
SESSION_SECRET=               # beliebige lange Zeichenkette
VAULT_PATH=C:/dev/flowstate-vault   # Pfad zu deinem geklonten Vault-Ordner
DATA_PATH=./data

# --- CRM [CRM] -------------------------------------------------------------
# Die Supabase-Datenbank. OHNE diese laeuft das CRM nicht.
DATABASE_URL=

# --- Alexandra / Hermes (Operating System) ---------------------------------
HERMES_CHAT_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# --- WhatsApp (optional) ---------------------------------------------------
# In welche Gruppen Alexandra schreiben darf — Namen exakt wie in WhatsApp,
# mit Komma getrennt. Was hier nicht steht, ist gesperrt (private Gruppen also
# automatisch). Leer = gar keine Gruppen.
WA_GRUPPEN=

# --- Suche (optional, aber empfohlen) --------------------------------------
# Serper (serper.dev) liefert echte Google-Treffer. Damit beantwortet Alexandra
# auch Aktuelles in ~2 s statt ueber die langsame Modell-Websuche.
# Ohne Schluessel wird Wikipedia genutzt — gratis, aber schwach bei "was ist gerade".
SERPER_API_KEY=

# --- Sprachbereich (optional) ----------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SCHNELL_CHAT_URL=
SCHNELL_API_KEY=
WAKE_WORD=
# Modell fuers VERSTEHEN der Sprachbefehle (Standard: claude-sonnet-5).
# Auf claude-haiku-4-5 stellen, wenn es guenstiger sein soll (versteht schlechter).
SPRACHE_VERSTEHEN_MODEL=
# Sprachprotokoll: Tagesdateien unter data/sprachlog/, Aufbewahrung in Tagen (Standard 30).
SPRACHLOG_TAGE=

# --- Rechnungen & Angebote (Absender auf dem PDF) --------------------------
# ZWEI Briefkoepfe, und das ist Absicht: Rechnungen gehen unter "SVH Consulting
# GbR", Angebote unter "Flowstate AI Solutions" — beide Am Anger 3, 84539
# Zangberg. So steht es in allen 30 Rechnungen und 18 Angeboten, die Lukas bis
# 05.09.2026 verschickt hat (Ordner Webseiten/Sale/Rechnungen).
#
# ALLES HIER IST OPTIONAL. Die Hausvorlage steht als Vorgabe im Code
# (lib/rechnungen.js, ABSENDER_VORGABE) — ohne .env schreibt das OS bereits
# richtig. Diese Zeilen sind nur da, um sie zu uebersteuern, z. B. wenn sich
# die Bankverbindung aendert. Reihenfolge: eigener Satz, dann FIRMA_*, dann
# Hausvorgabe. Ein leerer Wert zaehlt als "nicht gesetzt".

# Rechnung (Briefkopf "SVH CONSULTING", Serifenschrift):
RECHNUNG_ABSENDER_LOGO1=      # Vorgabe SVH          (schwarzer Teil des Logos)
RECHNUNG_ABSENDER_LOGO2=      # Vorgabe CONSULTING   (goldener Teil, #C9A84C)
RECHNUNG_ABSENDER_NAME=       # Vorgabe SVH Consulting GbR
RECHNUNG_ABSENDER_STRASSE=    # Vorgabe Am Anger 3
RECHNUNG_ABSENDER_PLZ_ORT=    # Vorgabe 84539 Zangberg
RECHNUNG_ABSENDER_ORT=        # Vorgabe Zangberg (steht in der Zeile "Zangberg, 04.09.2026")
RECHNUNG_ABSENDER_MAIL=       # Vorgabe jannikvomhofe83@gmail.com
RECHNUNG_ABSENDER_TELEFON=    # Vorgabe +49 1511 7796888
RECHNUNG_ABSENDER_IBAN=       # Vorgabe DE21 7115 1020 0032 0980 71
RECHNUNG_ABSENDER_BIC=        # Vorgabe BYLADEM1MDF
RECHNUNG_ABSENDER_KONTOINHABER=   # Vorgabe Jannik vom Hofe
RECHNUNG_ABSENDER_STEUERNR=   # Vorgabe 141/174/10707   (Fusszeile)
RECHNUNG_ABSENDER_USTID=      # Vorgabe DE464385333     (Fusszeile)
RECHNUNG_ABSENDER_VERTRETEN=  # Vorgabe Lukas Sehorz, Jannik vom Hofe
RECHNUNG_ABSENDER_UNTERSCHRIFT=   # Vorgabe Jannik vom Hofe (wer unterschreibt)

# Angebot (Briefkopf "FLOWSTATE AI SOLUTIONS", Arial/Helvetica, ohne Bank und
# ohne Steuernummer — die stehen in keinem der 18 Angebote):
ANGEBOT_ABSENDER_LOGO1=       # Vorgabe FLOWSTATE
ANGEBOT_ABSENDER_LOGO2=       # Vorgabe AI SOLUTIONS
ANGEBOT_ABSENDER_CLAIM=       # Vorgabe Webdesign · SEO · KI-Suchoptimierung
ANGEBOT_ABSENDER_NAME=        # Vorgabe Flowstate AI Solutions
ANGEBOT_ABSENDER_RECHTSFORM=  # Vorgabe Sehorz Lukas, vom Hofe Jannik GbR
ANGEBOT_ABSENDER_STRASSE=     # Vorgabe Am Anger 3
ANGEBOT_ABSENDER_PLZ_ORT=     # Vorgabe 84539 Zangberg
ANGEBOT_ABSENDER_MAIL=        # Vorgabe Lukas.sehorz@hotmail.com
ANGEBOT_ABSENDER_TELEFON=     # Vorgabe 0172 3465896
ANGEBOT_ABSENDER_VERTRETEN=   # Vorgabe Lukas Sehorz, Jannik vom Hofe
ANGEBOT_ABSENDER_UNTERSCHRIFT=    # Vorgabe Lukas Sehorz

# Gemeinsame Rueckfallebene fuer BEIDE Belegarten (aelterer Satz). Greift nur,
# wo der belegeigene Wert leer ist. Leer lassen, solange die Hausvorlage passt.
FIRMA_NAME=
FIRMA_STRASSE=
FIRMA_PLZ_ORT=
FIRMA_MAIL=
FIRMA_TELEFON=
FIRMA_IBAN=
FIRMA_BIC=
FIRMA_BANK=
FIRMA_STEUERNR=
# Absender der Rechnungs-Mails (Gmail), z. B. "Lukas Sehorz <lukas.sehorz@flowstate-ai.net>"
# Leer = "<Unterschrift> <Mailadresse des Briefkopfs>".
MAIL_ABSENDER=

# --- Buchhaltung (Belege, Monatsabschluss, Kanzlei) -----------------------
# Alles optional: Ohne diese Werte laeuft die Buchhaltung mit Hochladen, Buchen,
# Excel und ZIP. Es fehlen dann nur das automatische Auslesen und der Versand.
# Belege auslesen (Betrag, Datum, Lieferant aus Foto/PDF). Schluesselkette:
# ANTHROPIC_API_KEY, sonst SCHNELL_API_KEY, sonst HERMES_API_KEY.
ANTHROPIC_API_KEY=
BELEG_MODELL=                 # Standard claude-opus-5
# Postfach-Import (Belege-Seite "Postfach jetzt prüfen" und taeglicher Lauf).
# WELCHES Postfach: das Konto hinter dem gws-cli-Zugang (GWS_HOME bzw.
# GWS_TOKEN_DATEI) — ein anderes Konto laesst sich nicht per Variable waehlen,
# dafuer muss der Zugang neu eingerichtet werden.
MAIL_BELEGE_STUNDE=           # Uhr (Berlin) fuer den taeglichen Lauf, Standard REPORT_STUNDE-1
MAIL_BELEGE_SUCHE=            # Zusatzfilter fuer die Gmail-Suche, z. B. "-from:newsletter@" oder "label:Rechnungen"
EIGENE_DOMAENEN=flowstate-ai.net   # eigene Absender (Komma) — was von dort kommt, ist keine Ausgabe
DIENST_KONTO=                 # Admin-Konto, unter dem Telegram- und Postfach-Belege abgelegt werden.
                              # MUSS eine E-Mail aus der Datenbank sein (scripts/passwort-setzen.js --liste).
                              # Leer = aeltestes aktives Admin-Konto. Bis 07.09.2026 stand als Vorgabe im
                              # Code eine Adresse, die es nicht gab — jeder Lauf endete in 403.
# Steuerkanzlei: Adresse steht in der Buchhaltung (Monatsabschluss -> Kanzlei);
# diese beiden sind nur der Rueckfall, wenn dort nichts eingetragen ist.
STEUER_MAIL=
STEUER_NAME=
STEUER_MODUS=                 # leer = Gmail-ENTWURF anlegen (Standard) · "senden" = direkt senden
STEUER_MAX_ANHANG=            # Bytes, Standard 17 MB — groessere Monatsordner gehen nicht per Mail
# Rechnungen/Angebote per Sprache aus DOCX-Vorlagen (alter Weg, LibreOffice):
VORLAGEN_PFAD=                # Standard /vorlagen
BELEG_AUSGANG=                # Standard /data/belege-ausgang
ANGEBOT_MODELL=               # Standard claude-sonnet-5
# Oeffentliche Adresse des OS — die Belege-Seite zeigt damit den Link fuer den
# Handy-Scan ("Vom Handy: <OS_URL>/buchhaltung/scan"), und der Kalender
# schreibt sie in die Zeile "Kundenakte: <OS_URL>/crm/firma/<id>" jedes
# Termins mit Akte (lib/kalender-akte.js) — so fuehrt der Link auch im Handy
# in die Akte. Leer = eigene Adresse bzw. relativer Link.
OS_URL=

# --- CRM-Aufgaben im Google Kalender (lib/crm.js, 08.09.2026) ---
# Eine Aufgabe mit Firma UND Datum bekommt einen ganztaegigen Eintrag im
# Kalender ("CRM: Nochmal anrufen — Muster GmbH"), mit der Akte-Zeile in der
# Beschreibung. Datum verschoben heisst Termin verschoben, abgehakt oder
# geloescht heisst abgesagt. Ein gebuchtes Erstgespraech steht ueber
# erstgespraechSynchronisieren schon mit Uhrzeit drin und bekommt KEINEN
# zweiten Eintrag.
# "aus" schaltet das ab, wenn der Kalender zuwachsen sollte — die Aufgaben
# stehen dann weiter in der Liste und auf dem Whiteboard. Vorgabe "an".
KALENDER_AUFGABEN=an

# --- Beleg diktieren und verschicken (lib/beleg-diktat.js, lib/beleg-versand.js) ---
# Das Verstehen des Diktats und das Formulieren der Nachricht laufen ueber
# SCHNELL_API_KEY/SCHNELL_PROVIDER=anthropic (siehe oben). Fehlt der Schluessel,
# zeigt die Diktat-Seite einen ruhigen Hinweis und legt einen leeren Entwurf mit
# dem Text als Notiz an; die Nachricht nimmt dann die feste Fassung. Nichts
# scheitert hart.
DIKTAT_MODELL=                # Standard claude-sonnet-5 (Diktat verstehen)
VERSAND_MODELL=               # Standard claude-sonnet-5 (Mail-/WhatsApp-Text formulieren)
# Adresse, unter der der Kunde das PDF abruft (WhatsApp kann keine Datei
# mitschicken, deshalb ein signierter Link GET /r/<schluessel>, 30 Tage gueltig).
# Leer = OS_URL (unten), und ohne beides die Adresse aus der Anfrage.
BELEG_LINK_BASIS=
