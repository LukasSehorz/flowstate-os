# Hermes: Geheimnisse und Schalter. Wird als /docker/hermes/.env abgelegt
# (einrichten.sh erzeugt die Datei mit frischen Schluesseln, wenn sie fehlt).
# Kein API-Schluessel fuer Modelle: Hermes nutzt das ChatGPT-Pro-Abo ueber
# den Geraetecode-Login (docker exec -it hermes hermes model). Der Login
# liegt danach in data/auth.json.

# --- API-Server (OpenAI-kompatibel), den das Dashboard ruft ------------------
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0          # nur im Docker-Netz erreichbar, kein Port nach aussen
API_SERVER_PORT=8642
API_SERVER_KEY=                  # einrichten.sh: openssl rand -hex 24

# --- Hermes-Dashboard (Port 9119, nur Loopback, per SSH-Tunnel) --------------
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=lukas
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=   # einrichten.sh: openssl rand -hex 12

# --- Zugang zum Flowstate OS (Skill flowstate-os-api) ------------------------
# Der Token wird in Stufe 2 im Dashboard als Dienst-Token eingetragen
# (Kopfzeile x-dienst-token). Bis dahin nutzt der Skill nur /api/melde.
FLOWSTATE_OS_URL=http://flowstate-dashboard:3000
FLOWSTATE_OS_TOKEN=              # einrichten.sh: openssl rand -hex 24
MELDE_SECRET=                    # derselbe Wert wie MELDE_SECRET in der Dashboard-.env

# --- Container-Nutzer (Dateien im Vault gehoeren 10000:10000) ----------------
PUID=10000
PGID=10000
